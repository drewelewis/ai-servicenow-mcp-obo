# Git / VCS
.git
.gitignore

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment & secrets (NEVER ship these in the image)
.env
.env.*
.servicenow-jwt/
*.pem

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Azure / local tooling artifacts
.azure/
AzuriteConfig/
__azurite_db*__.json

# Log files (must not be in build context; they can grow during tar packing
# and break azd remote build with "archive/tar: write too long")
*.log
azd-up*.log

# Docs and tests not needed at runtime
tests/
*.md
!README.md
